generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Entry {
  id              Int     @id @default(autoincrement())
  position        Int
  content         String
  quantity        Float   @default(1)
  unit            String  @default("kpl")
  additionalInfo  String  @default("")
  checked         Boolean @default(false)
}

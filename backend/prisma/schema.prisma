generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Entry {
  id              Int     @id @default(autoincrement())
  position        Int
  content         String
  quantity        Float
  unit            String
  additionalInfo  String
  checked         Boolean @default(false)
}
